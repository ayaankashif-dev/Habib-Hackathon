# --- Supabase (persistence for the Victim <-> Guardian relay) ---
# Required for the relay to work at all. Get these from your Supabase
# project settings (Project Settings -> API). After setting them, run
# supabase/migrations/0001_cases.sql once in the Supabase SQL editor —
# see README.md for the one-time setup step.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Free-tier AI (all optional) ---
# The rule-based risk engine and OCR (tesseract.js fallback) work with ZERO
# keys below — see PRD section 14.3: the app must never depend on an AI call
# to be safe. Setting these adds extra fidelity, all on free tiers:

# Primary semantic risk-classification pass. Free, no credit card:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback if Gemini is unset/unreachable, and also used to transcribe
# UPLOADED voice note files. Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Primary OCR provider for screenshot uploads (faster than the tesseract.js
# fallback, which always runs regardless). Free, no credit card:
# https://ocr.space/ocrapi
OCR_API_KEY=
